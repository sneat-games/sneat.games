{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sneat-games",
  "compatibility_date": "2026-06-23",
  "workers_dev": true,
  // Edge router (worker.js): folds /en/ -> /, sends unprefixed legal pages to
  // the default locale, and otherwise serves the built static asset. There is
  // no app behind this site — an asset miss 404s as itself.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // Apex custom domain — Cloudflare manages the proxied DNS record + TLS cert.
  // We deliberately do NOT add a www custom domain (that serves duplicate
  // content); use a zone Redirect Rule (www -> apex, 301) instead.
  "routes": [
    { "pattern": "sneat.games", "custom_domain": true }
  ]
}
