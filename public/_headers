# Hashed build output never changes under the same name. One wildcard per
# rule is allowed, so game directories use the :game placeholder.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/:game/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service workers and the migration hand-over must always be revalidated:
# a cached kill switch or a stale game worker is exactly the "frozen build"
# failure these files exist to prevent.
/sw.js
  Cache-Control: no-cache
/:game/sw.js
  Cache-Control: no-cache
# Served at /__migrate (html_handling drops the .html with a 307).
/__migrate
  Cache-Control: no-store
/__migrate.html
  Cache-Control: no-store
